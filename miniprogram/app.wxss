page { background: #F5F7F2; font-size: 30rpx; color: #333; }
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.05); }
.title { font-size: 34rpx; font-weight: bold; margin-bottom: 16rpx; }
.btn { background: #4CAF50; color: #fff; border-radius: 40rpx; margin-top: 20rpx; }
.btn-light { background: #E8F5E9; color: #2E7D32; border-radius: 40rpx; margin-top: 20rpx; }
.chips { display: flex; flex-wrap: wrap; }
.chip { padding: 12rpx 28rpx; margin: 8rpx; border-radius: 30rpx; background: #eee; }
.chip.on { background: #4CAF50; color: #fff; }
.muted { color: #999; font-size: 26rpx; }
.ok { color: #2E7D32; } .bad { color: #E53935; }
textarea, input { background: #FAFAFA; border: 1rpx solid #ddd; border-radius: 12rpx; padding: 16rpx; width: auto; }
textarea { height: 200rpx; width: 100%; box-sizing: border-box; }
.step { padding: 12rpx 0; border-bottom: 1rpx dashed #eee; }
